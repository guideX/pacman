{
  "schemaVersion": 1,
  "id": "com.guidexos.pacman",
  "displayName": "Nexgen PacMan",
  "version": "0.1.0",
  "publisher": "Team Nexgen / guideXOS",
  "description": "Static guideXOS Native ELF rendering milestone for the historical Nexgen PacMan game.",
  "category": "Games",
  "kind": "NativeElf",
  "icon": "",
  "minGuideXOSVersion": "0.1.0",
  "supportedArchitectures": [
    "amd64"
  ],
  "entries": [
    {
      "architecture": "amd64",
      "path": "bin/amd64/pacman.elf",
      "entryPoint": "gx_main",
      "abi": "guidexos-c-abi-v1",
      "runtime": "native-elf"
    }
  ],
  "permissions": [
    "log",
    "window",
    "draw",
    "file.read"
  ],
  "fileAssociations": [],
  "defaultWindow": {
    "width": 480,
    "height": 640,
    "resizable": false
  }
}
